q = artifacts
|> DataFrame.discard(["status", "artifact_uri", "seconds", "dataset", "task", "dataset_name", "dataset_split", "dataset_n_samples", "dataset_seed", "dataset_flags", "file_size"])
|> DataFrame.put("index", for(n <- Range.new(1, DataFrame.n_rows(artifacts)), do: Range.new(1, Enum.count(artifacts["times"][n - 1])) |> Enum.to_list()))
|> DataFrame.put("family",
  Series.transform(artifacts["model"], fn model -> Map.get(families, model) end))  
|> DataFrame.explode(["times", "tokens_in", "tokens_out", "index"])
