```elixir
models = total_ground_truth
  |> DataFrame.sort_by([active_parameters])
  |> DataFrame.select("model")
|> DataFrame.distinct()

models_and_hardware = total_ground_truth
  |> DataFrame.select("hardware")
|> DataFrame.distinct()
|> DataFrame.join(models, how: :cross)
|> DataFrame.to_rows()
  |> Enum.map(fn %{"model" => model, "hardware" => hardware} -> 
    text = total_ground_truth
    |> DataFrame.filter(model == ^model and hardware == ^hardware)
    |> DataFrame.n_rows()
    |> case do
      0 -> "not tested"
        _ -> nil
    end

    text = cond do
      model == "llama4:scout" and hardware == "DGX Spark" -> "infeasible"
      true -> text
    end
    
    %{"model" => model, "hardware" => hardware, "text" => text}
    end)
|> DataFrame.new()
```

