## Analysis of language style

```elixir
total_without_input = total
|> DataFrame.filter(field != "input")
  |> DataFrame.mutate(alternative_hypothesis: 1 - wilcoxon_token_out, relative_median_difference: relative_median_difference * 100, relative_median_difference_time: relative_median_difference_time * 100)
  |> DataFrame.transform(fn r ->
    [key: "#{r["model"]} (t = #{r["temperature"]})"]
  end)
|> DataFrame.sort_by(parameters)
```

```elixir
a_total = total_without_input
|> DataFrame.mutate(field: (if field == "input", do: "original", else: field))
|> DataFrame.group_by("field")
|> DataFrame.summarise(relative_median_difference: relative_median_difference, parameters: parameters, active_parameters: active_parameters, field_list: field, temperature: first(temperature), hardware: first(hardware))
|> DataFrame.to_rows()
```

```elixir
total_without_input
|> DataFrame.group_by("field")
|> DataFrame.filter(method == "ground_truth" and alternative_hypothesis >= 0.95)
|> DataFrame.summarise(
  amount: count(relative_median_difference),
  mean: round(mean(relative_median_difference), 2), 
  median: round(median(relative_median_difference), 2),
  standard_deviation: round(standard_deviation(relative_median_difference), 2)
)
```

```elixir
total_without_input
|> DataFrame.group_by("field")
|> DataFrame.filter(method == "ground_truth" and wilcoxon_time <= 0.05)
|> DataFrame.summarise(
  amount: count(relative_median_difference_time),
  mean: round(mean(relative_median_difference_time), 2), 
  median: round(median(relative_median_difference_time), 2),
  standard_deviation: round(standard_deviation(relative_median_difference_time), 2)
)
```

```elixir
colors = %{"simple" => "#eb7f83", "friendly" => "#ffc57e", "academic" => "#97abff"}
drop = ["field", "temperature", "hardware"]

vl = VegaLite.new(width: 400)
|> VegaLite.layers(
      Enum.map(a_total, fn %{"field" => field} = x ->
        color = Map.get(colors, field)

        VegaLite.new()
        |> VegaLite.data_from_values(Map.drop(x, drop))
        |> VegaLite.layers([
          VegaLite.new()
          |> VegaLite.mark(:point, color: color)
          |> VegaLite.encode_field(:x, "active_parameters", type: :quantitative, title: "Count of active parameters")
          |> VegaLite.encode_field(:y, "relative_median_difference", type: :quantitative, scale: [domain: [-10, 18]], axis: %{"labelExpr" => "datum.label + '%'"}, title: "Relative Median Difference")
          |> VegaLite.encode_field(:color, "field_list", type: :nominal, title: "Language style")
        ])
        end)
      
    
)

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/regression-quotient.pdf")

vl
```

