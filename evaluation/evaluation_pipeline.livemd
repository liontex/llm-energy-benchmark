```elixir
q_ws = artifacts_ws
|> DataFrame.discard(["status", "artifact_uri", "seconds", "dataset", "task", "dataset_name", "dataset_split", "dataset_n_samples", "dataset_seed", "dataset_flags", "file_size"])
|> DataFrame.put("index", for(n <- Range.new(1, DataFrame.n_rows(artifacts_ws)), do: Range.new(1, Enum.count(artifacts_ws["times"][n - 1])) |> Enum.to_list()))
