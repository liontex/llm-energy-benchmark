## Graphs for Workshop

```elixir
total_ground_truth_without_input = total_without_input
|> DataFrame.filter(method == "ground_truth")
  |> DataFrame.mutate(energy_per_token: energy_total / n_tokens_out_total)
  |> DataFrame.mutate(abs_energy_diff: diff_median_token_out * energy_per_token)
  |> DataFrame.mutate(rel_energy_diff: abs_energy_diff / ((median_token_out * energy_per_token) - abs_energy_diff))
  |> DataFrame.group_by(["hardware", "model", "field"])
  |> DataFrame.summarise(
    rel_med_diff: mean(rel_energy_diff) * 100, 
    wilcoxon_token_out: mean(wilcoxon_token_out), 
    active_parameters: first(active_parameters)
  )
  |> DataFrame.mutate(
    significance: 
      if wilcoxon_token_out > 0.05 do 
        "" 
      else 
        if wilcoxon_token_out > 0.01 do
          "*"
        else
          if wilcoxon_token_out > 0.001 do
            "**"
          else
            "***"
          end
        end
      end
  )
|> DataFrame.sort_by(active_parameters)
```

```elixir
font_size = 20
vl =
  VegaLite.new()
  |> VegaLite.concat(
    [
      VegaLite.new(width: 500, title: [
        text: "DGX Spark",
        font_size: font_size
      ])
      |> VegaLite.data_from_values(total_ground_truth_without_input,
        only: ["model", "field", "rel_med_diff", "active_parameters", "significance", "hardware"]
      )
      |> VegaLite.transform(filter: "datum.hardware == 'DGX Spark'")
      |> VegaLite.encode_field(:x, "model",
        type: :nominal,
        sort: [field: "active_parameters"],
        title: nil,
        axis: [
          label_font_size: font_size
        ]
      )
      |> VegaLite.encode_field(:y, "rel_med_diff",
        aggregate: :median,
        type: :quantitative,
        scale: [domain: [-12, 18]],
        axis: [
          grid_color: [condition: [test: "datum.value === 0", value: "black"], value: "#ddd"],
          label_expr: "datum.label + '%'",
          label_font_size: font_size,
          title_font_size: font_size
        ],
        title: "Relative Difference of Energy"
      )
      |> VegaLite.encode_field(:x_offset, "field", type: :nominal)
      |> VegaLite.layers([
        VegaLite.new()
        |> VegaLite.mark(:bar)
        |> VegaLite.encode_field(:color, "field", type: :nominal, title: ""),
        VegaLite.new()
        |> VegaLite.transform(filter: "datum.rel_med_diff >= 0")
        |> VegaLite.mark(:text,
          baseline: "top",
          dy: -12,
          font_size: font_size
        )
        |> VegaLite.encode_field(:text, "significance", type: :nominal),
        VegaLite.new()
        |> VegaLite.transform(filter: "datum.rel_med_diff < 0")
        |> VegaLite.mark(:text,
          baseline: "bottom",
          dy: 20,
          font_size: font_size
        )
        |> VegaLite.encode_field(:text, "significance", type: :nominal)
      ]),
      VegaLite.new(width: 500, title: [
        text: "Workstation",
        font_size: font_size
      ])
      |> VegaLite.data_from_values(total_ground_truth_without_input,
        only: ["model", "field", "rel_med_diff", "active_parameters", "significance", "hardware"]
      )
      |> VegaLite.transform(filter: "datum.hardware == 'Workstation'")
      |> VegaLite.encode_field(:x, "model",
        type: :nominal,
        sort: [field: "active_parameters"],
        title: "Model",
        axis: [
          label_font_size: font_size,
          title_font_size: font_size
        ]
      )
      |> VegaLite.encode_field(:y, "rel_med_diff",
        aggregate: :median,
        type: :quantitative,
        scale: [domain: [-10, 20]],
        axis: [
          grid_color: [condition: [test: "datum.value === 0", value: "black"], value: "#ddd"],
          label_expr: "datum.label + '%'",
          label_font_size: font_size,
          title_font_size: font_size
        ],
        title: "Relative Difference of Energy"
      )
      |> VegaLite.encode_field(:x_offset, "field", type: :nominal)
      |> VegaLite.layers([
        VegaLite.new()
        |> VegaLite.mark(:bar)
        |> VegaLite.encode_field(:color, "field", 
          type: :nominal, 
          title: "Language style", 
          legend: [
            label_font_size: font_size,
            title_font_size: font_size,
            direction: :horizontal,
            orient: "bottom"
          ]
        ),
        VegaLite.new()
        |> VegaLite.transform(filter: "datum.rel_med_diff >= 0")
        |> VegaLite.mark(:text,
          baseline: "top",
          dy: -12,
          font_size: font_size
        )
        |> VegaLite.encode_field(:text, "significance", type: :nominal),
        VegaLite.new()
        |> VegaLite.transform(filter: "datum.rel_med_diff < 0")
        |> VegaLite.mark(:text,
          baseline: "bottom",
          dy: 20,
          font_size: font_size
        )
        |> VegaLite.encode_field(:text, "significance", type: :nominal)
      ])
    ],
    :vertical
  )

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/wilcoxon-all.pdf")

