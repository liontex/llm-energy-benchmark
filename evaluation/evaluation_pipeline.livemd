    |> VegaLite.mark(:point)
    |> VegaLite.transform(filter: "datum.hardware == 'DGX Spark'")
    |> VegaLite.encode_field(:y, "model", sort: "hardware", type: :nominal, axis: nil)
    |> VegaLite.encode_field(:x, "energy", type: :quantitative, scale: [domain: [1, 50000], type: :log], aggregate: :mean, title: nil, axis: [labels: false, ticks: false, domain: false])
    |> VegaLite.encode_field(:color, "key_method", type: :nominal),
    VegaLite.new(width: 200, height: 200)
    |> VegaLite.data_from_values(total,
      only: ["key_hardware", "model", "energy", "key_method", "hardware"]
    )
    |> VegaLite.mark(:point)
    |> VegaLite.transform(filter: "datum.hardware == 'Workstation'")
    |> VegaLite.encode_field(:y, "model", sort: "hardware", type: :nominal, axis: nil)
    |> VegaLite.encode_field(:x, "energy", type: :quantitative, scale: [domain: [1, 50000], type: :log], aggregate: :mean, title: "Energy in Ws")
    |> VegaLite.encode_field(:color, "key_method", type: :nominal)
  ], :vertical),
  VegaLite.new()
  |> VegaLite.concat([
    VegaLite.new(width: 200, height: 200)
    |> VegaLite.data_from_values(total,
      only: ["key_hardware", "model", "absolute_error_abs", "key_method", "hardware"]
    )
    |> VegaLite.mark(:point)
    |> VegaLite.transform(filter: "datum.key_method != 'Ground Truth'")  
    |> VegaLite.transform(filter: "datum.hardware == 'DGX Spark'")
    |> VegaLite.encode_field(:y, "model", sort: "hardware", type: :nominal, axis: nil)
    |> VegaLite.encode_field(:x, "absolute_error_abs", type: :quantitative, scale: [domain: [1, 50000], type: :log], aggregate: :mean, title: nil, axis: [labels: false, ticks: false, domain: false])
    |> VegaLite.encode_field(:color, "key_method", type: :nominal),
    VegaLite.new(width: 200, height: 200)
    |> VegaLite.data_from_values(total,
      only: ["key_hardware", "model", "absolute_error_abs", "key_method", "hardware"]
    )
    |> VegaLite.mark(:point)
    |> VegaLite.transform(filter: "datum.key_method != 'Ground Truth'")  
    |> VegaLite.transform(filter: "datum.hardware == 'Workstation'")
    |> VegaLite.encode_field(:y, "model", sort: "hardware", type: :nominal, axis: nil)
    |> VegaLite.encode_field(:x, "absolute_error_abs", type: :quantitative, scale: [domain: [1, 50000], type: :log], aggregate: :mean, title: "Absolute Error in Ws")
    |> VegaLite.encode_field(:color, "key_method", type: :nominal, title: "Tracking Method")
  ], :vertical)
], :horizontal)

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/tracking_methods-folie.pdf")

vl
```

## Analysis of hardware

```elixir
total
|> DataFrame.group_by(["hardware", "model", "method"])
|> DataFrame.summarise(power: mean(power), energy: mean(energy), 
  absolute_error: mean(absolute_error_abs), relative_error: median(relative_error),
  relative_power_error: mean(relative_power_error)
)
|> DataFrame.filter(hardware == "Workstation" and model in ["gemma4:31b", "llama4:scout"])
```

```elixir
hw_analysis = total_ground_truth
|> DataFrame.filter(hardware == "DGX Spark")
|> DataFrame.join(DataFrame.filter(total_ground_truth, hardware == "Workstation"), 
  on: [model: :model, temperature: :temperature, field: :field, 
    dataset_model: :dataset_model])
|> DataFrame.mutate(
  energy_absolute_difference_abs: abs(energy - energy_right),
  energy_absolute_difference: -1 * (energy_right - energy),
  energy_relative_difference: (-1 * (energy_right - energy) / energy_right) * 100,
  time_absolute_difference_abs: abs(running_time_total - running_time_total_right),
  time_absolute_difference: -1 * (running_time_total_right - running_time_total),
  time_relative_difference: (-1 * (running_time_total_right - running_time_total) / running_time_total_right) * 100
)
|> DataFrame.sort_by(active_parameters)
#|> DataFrame.filter(dataset_model != "GPT5-mini-Studierende")
```

