```elixir
artifacts_total = q
|> DataFrame.concat_rows(q_ws)
  |> DataFrame.mutate(
    energy_per_prompt: tokens_out * (ground_truth_power_draw_total / n_tokens_out_total),
    dyn_per_prompt: tokens_out * (power_draw_total / n_tokens_out_total),
    stat_per_prompt: tokens_out * (static_energy_estimation_total / n_tokens_out_total)
  )
|> DataFrame.filter(energy_per_prompt > 0 and times > 0 and times < 900)
|> DataFrame.sort_by(active_parameters)
