## Analysis of methods

```elixir
methods = %{"ml_emission_calculator" => "Static Estimation", 
  "codecarbon" => "Dynamic Estimation", 
  "ground_truth" => "Ground Truth"}

total = total
|> DataFrame.mutate(
  absolute_error: ground_truth_power_draw - energy,
  absolute_error_abs: abs(ground_truth_power_draw - energy),
  relative_error: ((energy / ground_truth_power_draw) * 100) - 100,
  relative_power_error: (((energy / running_time) / (ground_truth_power_draw / running_time)) * 100) - 100,
  power: energy / running_time,
  power_total: energy_total / running_time_total
)
|> DataFrame.transform(
  [names: ["model", "temperature", "field", "architecture", "hardware", "method"]],
  fn row ->
    %{
      key_total: "#{row["model"]}@#{row["architecture"]}, t=#{row["temperature"]}, field=#{row["field"]}",
      key_architecture: "#{row["model"]}@#{row["architecture"]}",
      key_hardware: "#{row["model"]}@#{row["hardware"]}",
      key_configuration: "#{row["model"]}@#{row["hardware"]}, t=#{row["temperature"]}",
      key_method: Map.get(methods, row["method"])
    }
  end
)
```

