### The next step has to be executed manually:

1. Open the `lmm.py` in the `evaluation` folder
2. Check for the correct formula and fitting of the model
3. Execute `python lmm.py` in your bash (for Experiments with 1000 Prompts this may take up to one hour)
4. Adjust the paths of the output files in the next cell accoring to your results
5. Continue with this livebook

```elixir
lmm_result_list = [
  #"#{base_path}/results/lmm_results/results/time-log-no-interaction-mixedlm_fixed_effects.csv",
  #"#{base_path}/results/lmm_results/results/token-no-interaction-mixedlm_fixed_effects.csv",
  #"#{base_path}/results/lmm_results/results/time-log-no-interaction-new.csv",
  "#{base_path}/evaluation/mixedlm_fixed_effects.csv"
]
```

```elixir
lmm_result_list = lmm_result_list
  |> Enum.map(fn path ->
  path
  |> DataFrame.from_csv!(delimiter: ";")
  |> DataFrame.mutate(category: replace(category, "T.", ""))
    |> DataFrame.mutate(category: replace(category, ", Treatment(reference='input')", ""))
|> DataFrame.mutate(category: replace(category, ", Treatment(reference='Workstation')", ""))
    |> DataFrame.mutate(category: replace(category, ", Treatment(reference='Gemma')", ""))
    |> DataFrame.mutate(category: replace(category, ", Treatment(reference='Llama')", ""))
    |> DataFrame.mutate(dimension: 
      if contains(category, "field") do
        "reformulation"
      else
        if contains(category, "model") do
          "model"
        else
          if contains(category, "temperature") do
            "temperature"
          else
            if contains(category, "hardware") do
              "hardware"
            else
              if contains(category, "family") do
                "hardware"
              else
                "LMM specific"
              end
            end
          end
        end
      end,
      significance: 
      if p_value > 0.05 do 
        "" 
      else 
        if p_value > 0.01 do
          "*"
        else
          if p_value > 0.001 do
            "**"
          else
            "***"
          end
        end
      end
      )
    end)
```

```elixir
vl = VegaLite.new()
|> VegaLite.concat([
  VegaLite.new(width: 250)
|> VegaLite.data_from_values(Enum.at(lmm_result_list, 0), only: ["coefficient", "category", "dimension", "significance"])
|> VegaLite.encode_field(:x, "coefficient", type: :quantitative, axis: [grid_color: [condition: [test: "datum.value === 0", value: "black"], value: "#ddd"]], title: "Running time (logarithmic)")
|> VegaLite.encode_field(:y, "category", type: :nominal, title: "Category for fixed effect")
  |> VegaLite.layers([
  VegaLite.new()
  |> VegaLite.mark(:bar)
  |> VegaLite.encode_field(:color, "dimension", type: :nominal),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.coefficient >= 0")
  |> VegaLite.mark(:text,
    align: "left",
    angle: 270,
    dy: 10, dx: -5)
  |> VegaLite.encode_field(:text, "significance", type: :nominal),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.coefficient < 0")
  |> VegaLite.mark(:text,
    align: "right",
    angle: 90,
    dx: 5, dy: 10)
  |> VegaLite.encode_field(:text, "significance", type: :nominal)
]),
  VegaLite.new(width: 250)
|> VegaLite.data_from_values(Enum.at(lmm_result_list, 0), only: ["coefficient", "category", "dimension", "significance"])
|> VegaLite.encode_field(:x, "coefficient", type: :quantitative, scale: [domain: [-600, 1000]], axis: [grid_color: [condition: [test: "datum.value === 0", value: "black"], value: "#ddd"]], title: "Amount of generated token")
|> VegaLite.encode_field(:y, "category", type: :nominal, axis: nil, title: nil)
    |> VegaLite.layers([
  VegaLite.new()
  |> VegaLite.mark(:bar)
|> VegaLite.encode_field(:color, "dimension", type: :nominal, title: "Dimension"),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.coefficient >= 0")
  |> VegaLite.mark(:text,
    align: "left",
    angle: 270,
    dy: 10, dx: -5)
  |> VegaLite.encode_field(:text, "significance", type: :nominal),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.coefficient < 0")
  |> VegaLite.mark(:text,
    align: "right",
    angle: 90,
    dx: 5, dy: 10)
  |> VegaLite.encode_field(:text, "significance", type: :nominal)
])
], :horizontal)

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/lmm-no-interaction.pdf")

vl
```

