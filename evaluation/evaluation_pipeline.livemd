```elixir
colors = %{"simple" => "#eb7f83", "friendly" => "#ffc57e", "academic" => "#97abff"}
drop = ["field", "temperature", "hardware"]

VegaLite.new(title: "Count of parameters vs. Quotient of Median Differences (#{result_ws_without_input["hardware"][0]})", width: 400)
|> VegaLite.layers(
      Enum.map(a_ws, fn %{"field" => field} = x ->
        color = Map.get(colors, field)

        VegaLite.new(title: "temperature = #{x["temperature"]}")
        |> VegaLite.data_from_values(Map.drop(x, drop))
        |> VegaLite.layers([
          VegaLite.new()
          |> VegaLite.mark(:point, color: color)
          |> VegaLite.encode_field(:x, "active_parameters", type: :quantitative)
          |> VegaLite.encode_field(:y, "relative_median_difference", type: :quantitative, scale: [domain: [-9, 18]], axis: %{"labelExpr" => "datum.label + '%'"}, title: "Quotient median difference")
          |> VegaLite.encode_field(:color, "field_list", type: :nominal, title: "language style"),
          VegaLite.new()
          |> VegaLite.mark(:line, color: color)
          |> VegaLite.transform(regression: "relative_median_difference", on: "active_parameters")
          |> VegaLite.transform(values: "field_list")
          |> VegaLite.encode_field(:x, "active_parameters", type: :quantitative, title: "Count of active parameters")
          |> VegaLite.encode_field(:y, "relative_median_difference", type: :quantitative)
        ])
        end)
)
