```elixir
artifacts_compact = artifacts_total
|> DataFrame.group_by(["hardware", "model", "temperature", "field", "active_parameters", "index"])
|> DataFrame.summarise(
  energy_per_prompt: mean(energy_per_prompt), 
  dyn_per_prompt: mean(dyn_per_prompt),
  stat_per_prompt: mean(stat_per_prompt),
  times: mean(times),
  tokens_out: mean(tokens_out)
  )
|> DataFrame.filter(index <= 333)
|> DataFrame.sort_by([hardware, active_parameters])
