```elixir
params_ws = conn_ws
|> Exqlite.query!("select key, value, params.run_uuid, runs.status, runs.artifact_uri, runs.experiment_id from params left join runs on params.run_uuid = runs.run_uuid where runs.experiment_id in (#{experiment_id_list})")
|> DataFrame.new()
|> DataFrame.pivot_wider("key", "value")
|> DataFrame.mutate(
  seconds: cast(seconds, {:u, 16}),
  temperature: round(cast(temperature, {:f, 32}), 1),
  dataset_n_samples: cast(dataset_n_samples, {:u, 16}),
  dataset_seed: cast(dataset_seed, {:u, 16}),
  dataset_temperature: round(cast(dataset_temperature, {:f, 32}), 1),
  file_size: cast(file_size, {:u, 32}),
  n_samples: cast(n_samples, {:u, 16}),
  parameters: cast(replace(parameters, "B", "e9"), {:f, 32}),
  hardware: "Workstation"
)
|> DataFrame.mutate(
  temperature: if(temperature > 0.69 and temperature <= 0.7, do: 0.7, else: temperature),
  active_parameters: if(model == "gemma4:e4b", do: 4500000000, else: 
    if(model == "llama4:scout", do: 17000000000, else: parameters))
)
