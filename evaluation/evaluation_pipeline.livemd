## Wilcoxon for Spark

```elixir
comparisons = comparisons
  |> Enum.map(fn %{"model" => model, "temperature" => temperature, "data" => data} ->

    input = (DataFrame.filter(data, field == "input"))["tokens_out"][0]
    simple = (DataFrame.filter(data, field == "simple"))["tokens_out"][0]
    friendly = (DataFrame.filter(data, field == "friendly"))["tokens_out"][0]
    academic = (DataFrame.filter(data, field == "academic"))["tokens_out"][0]

    input_median = input
    |> Series.from_list()
    |> Series.median()

    simple_median = simple
    |> Series.from_list()
    |> Series.median()

    friendly_median = friendly
    |> Series.from_list()
    |> Series.median()

    academic_median = academic
    |> Series.from_list()
    |> Series.median()

    time_input = (DataFrame.filter(data, field == "input"))["times"][0]
    time_simple = (DataFrame.filter(data, field == "simple"))["times"][0]
    time_friendly = (DataFrame.filter(data, field == "friendly"))["times"][0]
    time_academic = (DataFrame.filter(data, field == "academic"))["times"][0]

    time_input_median = time_input
    |> Series.from_list()
    |> Series.median()

    time_simple_median = time_simple
    |> Series.from_list()
    |> Series.median()

    time_friendly_median = time_friendly
    |> Series.from_list()
    |> Series.median()

    time_academic_median = time_academic
    |> Series.from_list()
    |> Series.median()
    
%{
  model: model,
  temperature: temperature,
  input: input,
  simple: simple,
  friendly: friendly,
  academic: academic,
  input_median: input_median,
  simple_median: simple_median,
  friendly_median: friendly_median,
  academic_median: academic_median,
  time_input: time_input,
  time_simple: time_simple,
  time_friendly: time_friendly,
  time_academic: time_academic,
  time_input_median: time_input_median,
  time_simple_median: time_simple_median,
  time_friendly_median: time_friendly_median,
  time_academic_median: time_academic_median
}
    end)
```

```python
wilcoxon_results = []
for comparison in comparisons:
  if len(comparison["input"]) == len(comparison["simple"]):
    simple = wilcoxon(comparison["input"], comparison["simple"], zero_method="pratt")
    simple_time = wilcoxon(comparison["time_input"], comparison["time_simple"], zero_method="pratt")
  else:
    simple = wilcoxon(comparison["input"][:len(comparison["simple"])], comparison["simple"], zero_method="pratt")
    simple_time = wilcoxon(comparison["time_input"][:len(comparison["time_simple"])], comparison["time_simple"], zero_method="pratt")

  if len(comparison["input"]) == len(comparison["friendly"]):
    friendly = wilcoxon(comparison["input"], comparison["friendly"], zero_method="pratt")
    friendly_time = wilcoxon(comparison["time_input"], comparison["time_friendly"], zero_method="pratt")
  else:
    friendly = wilcoxon(comparison["input"][:len(comparison["friendly"])], comparison["friendly"], zero_method="pratt")
    friendly_time = wilcoxon(comparison["time_input"][:len(comparison["time_friendly"])], comparison["time_friendly"], zero_method="pratt")

  if len(comparison["input"]) == len(comparison["academic"]):
    academic = wilcoxon(comparison["input"], comparison["academic"], zero_method="pratt")
    academic_time = wilcoxon(comparison["time_input"], comparison["time_academic"], zero_method="pratt")
  else:
    academic = wilcoxon(comparison["input"][:len(comparison["academic"])], comparison["academic"], zero_method="pratt")
    academic_time = wilcoxon(comparison["time_input"][:len(comparison["time_academic"])], comparison["time_academic"], zero_method="pratt")

  wilcoxon_results.append({"model": comparison["model"],
                          "temperature": comparison["temperature"],
                           "simple": simple,
                           "friendly": friendly,
                           "academic": academic,
                           "input_median": comparison["input_median"],
                           "simple_median": comparison["simple_median"],
                           "friendly_median": comparison["friendly_median"],
                           "academic_median": comparison["academic_median"],
                           "simple_time": simple_time,
                           "friendly_time": friendly_time,
                           "academic_time": academic_time,
                           "time_input_median": comparison["time_input_median"],
                           "time_simple_median": comparison["time_simple_median"],
                           "time_friendly_median": comparison["time_friendly_median"],
                           "time_academic_median": comparison["time_academic_median"]
                          })
```

```elixir
wilcoxon_results = wilcoxon_results
|> Pythonx.decode()
|> Enum.map(fn %{
  "simple" => {_, simple}, 
  "friendly" => {_, friendly}, 
  "academic" => {_, academic}, 
  "simple_time" => {_, simple_time}, 
  "friendly_time" => {_, friendly_time}, 
  "academic_time" => {_, academic_time}, 
  "model" => model, 
  "temperature" => temperature,
  "input_median" => input_median,
  "simple_median" => simple_median,
  "friendly_median" => friendly_median,
  "academic_median" => academic_median,
  "time_input_median" => time_input_median,
  "time_simple_median" => time_simple_median,
  "time_friendly_median" => time_friendly_median,
  "time_academic_median" => time_academic_median
} ->

  [
    %{"field" => "input", "median_time" => time_input_median, "median_token_out" => input_median, "diff_median_token_out" => 0, "diff_median_time" => 0, "wilcoxon_token_out" => 1, "wilcoxon_time" => 1, "model" => model, "temperature" => temperature},
    %{"field" => "simple", "median_time" => time_simple_median, "median_token_out" => simple_median, "diff_median_token_out" => -1 * (input_median - simple_median), "diff_median_time" => -1 * (time_input_median - time_simple_median), "wilcoxon_token_out" => simple, "wilcoxon_time" => simple_time, "model" => model, "temperature" => temperature},
    %{"field" => "friendly", "median_time" => time_friendly_median, "median_token_out" => friendly_median, "diff_median_token_out" => -1 * (input_median - friendly_median), "diff_median_time" => -1 * (time_input_median - time_friendly_median), "wilcoxon_token_out" => friendly, "wilcoxon_time" => friendly_time, "model" => model, "temperature" => temperature},
    %{"field" => "academic", "median_time" => time_academic_median, "median_token_out" => academic_median, "diff_median_token_out" => -1 * (input_median - academic_median), "diff_median_time" => -1 * (time_input_median - time_academic_median), "wilcoxon_token_out" => academic, "wilcoxon_time" => academic_time, "model" => model, "temperature" => temperature},
  ]
end)
|> List.flatten()
|> DataFrame.new()
|> DataFrame.mutate(
  relative_median_difference: diff_median_token_out / (median_token_out - diff_median_token_out),
  relative_median_difference_time: diff_median_time / (median_time - diff_median_time)
)
```

```elixir
result = result
|> DataFrame.join(wilcoxon_results)
```

```elixir
result_without_input = result
|> DataFrame.filter(field != "input")
  |> DataFrame.mutate(alternative_hypothesis: 1 - wilcoxon_token_out, alternative_hypothesis_time: 1 - wilcoxon_time,
    relative_median_difference: relative_median_difference * 100, 
    relative_median_difference_time: relative_median_difference_time * 100,
    significance: 
      if wilcoxon_token_out > 0.05 do 
        "" 
      else 
        if wilcoxon_token_out > 0.01 do
          "*"
        else
          if wilcoxon_token_out > 0.001 do
            "**"
          else
            "***"
          end
        end
      end,
    significance_time: 
      if wilcoxon_time > 0.05 do 
        "" 
      else 
        if wilcoxon_time > 0.01 do
          "*"
        else
          if wilcoxon_time > 0.001 do
            "**"
          else
            "***"
          end
        end
      end
  )
  |> DataFrame.transform(fn r ->
    [key: "#{r["model"]} (t = #{r["temperature"]})"]
  end)
|> DataFrame.sort_by(active_parameters)
```

```elixir
vl = VegaLite.new(title: "DGX Spark")
|> VegaLite.concat(
  [
    VegaLite.new(width: 750, height: 180)
|> VegaLite.data_from_values(result_without_input,
  only: ["key", "field", "diff_median_token_out", "active_parameters", "significance"]
)
|> VegaLite.encode_field(:x, "key", type: :nominal, axis: nil, sort: [field: "active_parameters"])
|> VegaLite.encode_field(:y, "diff_median_token_out", 
  aggregate: :median, 
  type: :quantitative, 
  scale: [domain: [-90, 90]],
  axis: [grid_color: [condition: [test: "datum.value === 0", value: "black"], value: "#ddd"]], 
    title: "Absolute Difference Median")
|> VegaLite.encode_field(:x_offset, "field", type: :nominal)
    |> VegaLite.layers([
  VegaLite.new()
  |> VegaLite.mark(:bar)
  |> VegaLite.encode_field(:color, "field", type: :nominal, title: "Language style"),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.diff_median_token_out >= 0")
  |> VegaLite.mark(:text,
    baseline: "top",
    dy: -12)
  |> VegaLite.encode_field(:text, "significance", type: :nominal),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.diff_median_token_out < 0")
  |> VegaLite.mark(:text,
    baseline: "bottom",
    dy: 13)
  |> VegaLite.encode_field(:text, "significance", type: :nominal)
]),
    VegaLite.new(width: 750, height: 180)
|> VegaLite.data_from_values(result_without_input,
  only: ["key", "field", "relative_median_difference", "active_parameters", "significance"]
)
|> VegaLite.encode_field(:x, "key", type: :nominal, sort: [field: "active_parameters"], title: "Model and Temperature")
|> VegaLite.encode_field(:y, "relative_median_difference", aggregate: :median, 
  type: :quantitative, 
  scale: [domain: [-15, 20]],
  axis: [grid_color: [condition: [test: "datum.value === 0", value: "black"], value: "#ddd"], label_expr: "datum.label + '%'"],
  title: "Relative Difference Median")
|> VegaLite.encode_field(:x_offset, "field", type: :nominal) 
    |> VegaLite.layers([
  VegaLite.new()
  |> VegaLite.mark(:bar)
  |> VegaLite.encode_field(:color, "field", type: :nominal, title: "Language style"),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.relative_median_difference >= 0")
  |> VegaLite.mark(:text,
    baseline: "top",
    dy: -12)
  |> VegaLite.encode_field(:text, "significance", type: :nominal),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.relative_median_difference < 0")
  |> VegaLite.mark(:text,
    baseline: "bottom",
    dy: 13)
  |> VegaLite.encode_field(:text, "significance", type: :nominal)
])
  ], :vertical
)

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/wilcoxon-spark.pdf")

vl
