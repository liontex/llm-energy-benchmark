  only: ["key", "field", "diff_median_token_out", "active_parameters", "significance"]
)
|> VegaLite.encode_field(:x, "key", type: :nominal, axis: nil, sort: [field: "active_parameters"])
|> VegaLite.encode_field(:y, "diff_median_token_out", 
  aggregate: :median, 
  type: :quantitative, 
  scale: [domain: [-50, 110]],
  axis: [grid_color: [condition: [test: "datum.value === 0", value: "black"], value: "#ddd"]], 
    title: "Absolute Difference Median")
|> VegaLite.encode_field(:x_offset, "field", type: :nominal)
    |> VegaLite.layers([
  VegaLite.new()
  |> VegaLite.mark(:bar)
  |> VegaLite.encode_field(:color, "field", type: :nominal, title: "Language style"),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.diff_median_token_out >= 0")
  |> VegaLite.mark(:text,
    baseline: "top",
    dy: -12)
  |> VegaLite.encode_field(:text, "significance", type: :nominal),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.diff_median_token_out < 0")
  |> VegaLite.mark(:text,
    baseline: "bottom",
    dy: 13)
  |> VegaLite.encode_field(:text, "significance", type: :nominal)
]),
    VegaLite.new(width: 750, height: 180)
|> VegaLite.data_from_values(result_ws_without_input,
  only: ["key", "field", "relative_median_difference", "active_parameters", "significance"]
)
|> VegaLite.encode_field(:x, "key", type: :nominal, sort: [field: "active_parameters"], title: "Model and Temperature")
|> VegaLite.encode_field(:y, "relative_median_difference", aggregate: :median, 
  type: :quantitative, 
  scale: [domain: [-10, 20]],
  axis: [grid_color: [condition: [test: "datum.value === 0", value: "black"], value: "#ddd"], label_expr: "datum.label + '%'"],
  title: "Relative Difference Median")
|> VegaLite.encode_field(:x_offset, "field", type: :nominal) 
    |> VegaLite.layers([
  VegaLite.new()
  |> VegaLite.mark(:bar)
  |> VegaLite.encode_field(:color, "field", type: :nominal, title: "Language style"),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.relative_median_difference >= 0")
  |> VegaLite.mark(:text,
    baseline: "top",
    dy: -12)
  |> VegaLite.encode_field(:text, "significance", type: :nominal),
  VegaLite.new()
  |> VegaLite.transform(filter: "datum.relative_median_difference < 0")
  |> VegaLite.mark(:text,
    baseline: "bottom",
    dy: 13)
  |> VegaLite.encode_field(:text, "significance", type: :nominal)
])
  ], :vertical
)

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/wilcoxon-ws.pdf")

vl
```

