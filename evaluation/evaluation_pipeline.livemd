## Spark

```elixir
experiment_id_list = [39, 49, 50] #39 -> Gemma3:27b, 49 -> Mistral-small3.2:24b, 50 -> GPT5-Studierende
|> Enum.join(", ")

runs = conn_spark
|> Exqlite.query!("select * from runs where experiment_id in (#{experiment_id_list})")
|> DataFrame.new()
```

```elixir
metrics = conn_spark
|> Exqlite.query!("select key, value, metrics.run_uuid from metrics left join runs on metrics.run_uuid = runs.run_uuid where runs.experiment_id in (#{experiment_id_list})")
|> DataFrame.new()
|> DataFrame.pivot_wider("key", "value")
```

```elixir
params = conn_spark
|> Exqlite.query!("select key, value, params.run_uuid, runs.status, runs.artifact_uri, runs.experiment_id from params left join runs on params.run_uuid = runs.run_uuid where runs.experiment_id in (#{experiment_id_list})")
|> DataFrame.new()
|> DataFrame.pivot_wider("key", "value")
|> DataFrame.mutate(
  seconds: cast(seconds, {:u, 16}),
  temperature: round(cast(temperature, {:f, 32}), 1),
  dataset_n_samples: cast(dataset_n_samples, {:u, 16}),
  dataset_seed: cast(dataset_seed, {:u, 16}),
  dataset_temperature: round(cast(dataset_temperature, {:f, 32}), 1),
  file_size: cast(file_size, {:u, 32}),
  n_samples: cast(n_samples, {:u, 16}),
  parameters: cast(replace(parameters, "B", "e9"), {:f, 32}),
  hardware: "DGX Spark"
)
|> DataFrame.mutate(
  temperature: if(temperature > 0.69 and temperature <= 0.7, do: 0.7, else: temperature),
  active_parameters: if(model == "gemma4:e4b", do: 4500000000, else: parameters)
)
```

```elixir
result = DataFrame.join(metrics, params)
```

```elixir
result = 
  result
|> DataFrame.mutate(
  static_energy_estimation: ^(Enum.at(spark["tdp_watts"], 0)) * running_time,
  static_energy_estimation_total: ^(Enum.at(spark["tdp_watts"], 0)) * running_time_total,
  token_out_per_second: n_tokens_out / (running_time_total - failed_time),
  n_tokens_out_total: n_tokens_out + (n_tokens_out / (running_time_total - failed_time)) * failed_time
)
|> DataFrame.put("artifact_uri", Series.transform(result["artifact_uri"], fn row -> 
  row
  |> String.replace("/home/horny/llm-energy-benchmark/experiments/mlruns", 
  "#{base_path}/results/mlflow_spark/mlruns")
  end))
```

## Artifacts for Spark

```elixir
artifacts = result
|> DataFrame.to_rows()
  |> Enum.reduce([], fn row, acc -> 

    value = "#{row["artifact_uri"]}/artifacts.json"
|> File.read!()
|> JSON.decode!()
    
    acc ++ [%{
      "run_uuid" => row["run_uuid"], 
      "times" => value["times"], 
      "tokens_in" => value["tokens_in"], 
      "tokens_out" => value["tokens_out"]}]
  end)
|> DataFrame.new()
|> DataFrame.join(result)
```

```elixir
comparisons = DataFrame.distinct(artifacts, ["model", "temperature"])
|> DataFrame.to_rows()
```

```elixir
comparisons = comparisons
  |> Enum.map(fn %{"model" => model, "temperature" => temperature} = map -> 
    current = artifacts
    |> DataFrame.filter(model == ^model and temperature == ^temperature)

    Map.put(map, "data", current)
  end)
```

## Single Experiment Evaluation for Spark

```elixir
Enum.at(comparisons, 0)
```

```elixir
single_experiment = comparisons
  |> Enum.at(0)
  |> Map.get("data")
  |> DataFrame.filter(dataset_model == "gemma3_27b")
|> DataFrame.to_rows()
|> Enum.map(fn %{"run_uuid" => run_uuid, "tokens_out" => tokens_out, "times" => times, "field" => field, "running_time_total" => running_time_total} ->
  tokens_out
  |> Enum.zip(times)
  |> Enum.with_index()
  |> Enum.map(fn {{token_out, time}, index} ->
    %{"run_uuid" => run_uuid, 
      "token_out" => token_out, 
      "time" => time, 
      "index" => index + 1, 
      "field" => field,
      "running_time_total" => running_time_total
    }
  end)
  end)
|> List.flatten()
|> DataFrame.new()
|> DataFrame.mutate(field: if(field == "input", do: "original", else: field))
```

```elixir
original = DataFrame.filter(single_experiment, field == "original" and time < 900 and token_out < 4000)
|> DataFrame.mutate(token_input: token_out, time_input: time, order: 4)
simple = DataFrame.filter(single_experiment, field == "simple" and time < 900 and token_out < 4000)
|> DataFrame.mutate(token_simple: token_out, time_simple: time, order: 1)
friendly = DataFrame.filter(single_experiment, field == "friendly" and time < 900 and token_out < 4000)
|> DataFrame.mutate(token_friendly: token_out, time_friendly: time, order: 2)
academic = DataFrame.filter(single_experiment, field == "academic" and time < 900 and token_out < 4000)
|> DataFrame.mutate(token_academic: token_out, time_academic: time, order: 3)

d = [simple: simple, friendly: friendly, academic: academic, original: original]
```

```elixir
%{"model" => model, "temperature" => temperature} = Enum.at(comparisons, 0)

vl = VegaLite.new(title: "Model: #{String.capitalize(model)}, temperature: #{temperature}, dataset LLM: Gemma3:27b", width: 600)
|> VegaLite.concat(Enum.map(d, fn {field, x} ->
  VegaLite.new(width: 600)
  |> VegaLite.mark(:rule)
  |> VegaLite.data_from_values(x, only: ["token_out", "field", "order"])
  |> VegaLite.encode_field(:x, "token_out", type: :quantitative, bin: [maxbins: 200], scale: [domain: [0, 3120]], title: (if field == :original, do: "Amount of generated token (binned with 200 bins)", else: nil))
  |> VegaLite.encode(:y, aggregate: :count, scale: [domain: [0, 50]], title: "Number of prompts")
  |> VegaLite.encode_field(:color, "field", type: :nominal, sort: "order", title: "Language style")
  end), :vertical)

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/token-binned.pdf")

vl
```

```elixir
dd = DataFrame.select(original, [:index, :token_input, :time_input])
|> DataFrame.join(DataFrame.select(simple, [:index, :token_simple, :time_simple]), on: [index: :index])
|> DataFrame.join(DataFrame.select(friendly, [:index, :token_friendly, :time_friendly]), on: [index: :index])
|> DataFrame.join(DataFrame.select(academic, [:index, :token_academic, :time_academic]), on: [index: :index])
|> DataFrame.mutate(
  diff_simple: token_input - token_simple,
  diff_friendly: token_input - token_friendly,
  diff_academic: token_input - token_academic,
  diff_time_simple: time_input - time_simple,
  diff_time_friendly: time_input - time_friendly,
  diff_time_academic: time_input - time_academic,
  diff_simple_academic: token_simple - token_academic,
  field_simple: "simple",
  field_friendly: "friendly",
  field_academic: "academic",
  order_simple: 1,
  order_friendly: 2,
  order_academic: 3
)
```

```elixir
names = %{
  "simple" => "Differences original - simple",
  "friendly" => "Differences original - friendly",
  "academic" => "Differences original - academic"
}
%{"model" => model, "temperature" => temperature} = Enum.at(comparisons, 0)
medians = Enum.map(Map.keys(names), fn name ->
  {name, [Series.median(dd["diff_#{name}"])]}
  end)
|> Map.new()

vl = VegaLite.new(title: "Model: #{String.capitalize(model)}, temperature: #{temperature}, dataset LLM: Gemma3:27b", width: 600)
|> VegaLite.concat(
  ["simple", "friendly", "academic"]
  |> Enum.map(fn field ->
  VegaLite.new(title: Map.get(names, field), width: 600)
  |> VegaLite.layers(
    [
      VegaLite.new()
      |> VegaLite.mark(:bar)
      |> VegaLite.data_from_values(dd)
      |> VegaLite.encode_field(:x, "diff_#{field}", type: :quantitative, bin: [maxbins: 200], scale: [domain: [-1600, 1600]], title: "Differences of amounts of generated token (200 bins), Median of Differences (black)")
      |> VegaLite.encode(:y, aggregate: :count, scale: [domain: [0, 100]])
      |> VegaLite.encode_field(:color, "field_#{field}", sort: "order_#{field}", type: :nominal, title: nil, legend: nil),
      VegaLite.new()
      |> VegaLite.mark(:rule, color: :black, size: 3)
      |> VegaLite.data_from_values(medians)
      |> VegaLite.encode_field(:x, field, type: :quantitative, scale: [domain: [-1600, 1600]])
    ]
  )
  end), :vertical)

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/differences-formulations.pdf")

vl
```

