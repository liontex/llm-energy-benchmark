]),
  VegaLite.new()
|> VegaLite.layers([
  VegaLite.new()
  |> VegaLite.data_from_values(artifacts_compact,
  only: ["model", "times", "hardware", "active_parameters"]
)
  |> VegaLite.mark(:boxplot)
|> VegaLite.encode_field(:x, "model", type: :nominal, sort: ["active_parameters"], title: "Model",
axis: [label_font_size: font_size, title_font_size: font_size])
|> VegaLite.encode_field(:x_offset, "hardware", type: :nominal)
|> VegaLite.encode_field(:y, "times",
  type: :quantitative,
  scale: [type: :log, domain: [0.01, 1200]],
  title: "Runtime per request in s",
  axis: [label_font_size: font_size, title_font_size: font_size]
)
|> VegaLite.encode_field(:color, "hardware", type: :nominal, legend: [label_font_size: font_size, title_font_size: font_size]),
  VegaLite.new()
  |> VegaLite.data_from_values(models_and_hardware)
  |> VegaLite.transform(filter: "datum.text != null")
        |> VegaLite.mark(:text,
          baseline: "top",
          dy: -10,
          angle: 270,
          font_size: font_size
        )
        |> VegaLite.encode_field(:x, "model", type: :nominal)
  |> VegaLite.encode_field(:x_offset, "hardware", type: :nominal)
        |> VegaLite.encode_field(:text, "text", type: :nominal)
  |> VegaLite.encode_field(:color, "hardware", type: :nominal)
])], :vertical)

VegaLite.Convert.save!(vl, "#{base_path}/results/grafics/energyandruntime_per_model.pdf")

vl
```

```elixir
f = artifacts_total
|> DataFrame.group_by(["hardware", "model"])
|> DataFrame.summarise(
  energy_stat: mean(stat_per_prompt), 
  energy_dyn: mean(dyn_per_prompt), 
  energy_ground: mean(energy_per_prompt),
  power_stat: mean(stat_per_prompt) / mean(times),
  power_dyn: mean(dyn_per_prompt) / mean(times),
  power_ground: mean(energy_per_prompt) / mean(times)
)
|> DataFrame.mutate(
  abs_error_dyn: abs(energy_ground - energy_dyn),
  abs_error_stat: abs(energy_ground - energy_stat),
  abs_error_ground: 0,
  rel_error_dyn: ((energy_ground - energy_dyn) / energy_ground) * 100,
  rel_error_stat: ((energy_ground - energy_stat) / energy_ground) * 100,
  rel_error_ground: 0
)
```

```elixir
f1 = f 
|> DataFrame.select(["hardware", "model", "energy_stat", "power_stat", "abs_error_stat", "rel_error_stat", "energy_ground"])
|> DataFrame.rename(%{energy_stat: :energy, power_stat: :power, abs_error_stat: :abs_error, rel_error_stat: :rel_error, energy_ground: :ground})
|> DataFrame.mutate(key_method: "Static")

f2 = f 
|> DataFrame.select(["hardware", "model", "energy_dyn", "power_dyn", "abs_error_dyn", "rel_error_dyn", "energy_ground"])
|> DataFrame.rename(%{energy_dyn: :energy, power_dyn: :power, abs_error_dyn: :abs_error, rel_error_dyn: :rel_error, energy_ground: :ground})
|> DataFrame.mutate(key_method: "Dynamic")

f3 = f 
|> DataFrame.select(["hardware", "model", "energy_ground", "power_ground", "abs_error_ground", "rel_error_ground"])
|> DataFrame.rename(%{energy_ground: :energy, power_ground: :power, abs_error_ground: :abs_error, rel_error_ground: :rel_error})
|> DataFrame.mutate(key_method: "Ground Truth", ground: energy)

f = DataFrame.concat_rows([f1, f2, f3])
```

